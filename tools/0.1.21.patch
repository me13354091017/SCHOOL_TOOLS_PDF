+    private void OnStrokesChanged(object? sender, StrokeCollectionChangedEventArgs e)
+    {
+        if (_droppingBarStroke || e.Added.Count == 0)
+            return;
+        var bar = InkToolBar.Current;
+        if (bar is null || !bar.IsBarInputRegionActive)
